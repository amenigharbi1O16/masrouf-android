<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH"/></intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Point d'entrée principal -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- Authentification & Onboarding -->
        <activity android:name=".LoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SignUpActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".OnboardingActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AccountTypeActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.OnboardingCategoriesActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.OnboardingConfirmActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.ChangePasswordActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- Profil Enfant -->
        <activity android:name=".view.child.ChildMainActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- Profil Parent & Foyer -->
        <activity android:name=".view.family.FamilyDashboardActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.family.FamilyChildrenActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.family.FamilyAnalyticsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.family.ChildProfileActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.family.FamilyFinancesActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.family.FamilyRequestsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.family.FamilyHistoryActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.family.FamilyPrivacyActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- Écrans partagés & Utilisateur Normal -->
        <activity android:name=".ProductsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AnalysesActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".HistoryActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.CalendarActivity" android:exported="false" />
        <activity android:name=".view.AnalyticsActivity" android:exported="false" />
        <activity android:name=".view.NotificationsActivity" android:exported="false" />
        <activity android:name=".view.SettingsActivity" android:exported="false" />
        <activity android:name=".view.PointsAndAchievementsActivity" android:exported="false" />
        <activity android:name=".view.CreateBudgetActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.AllocateBudgetActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.ModifyBudgetActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.SelectCategoryActivity" android:exported="false" />
        <activity android:name=".view.AddPurchaseActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.EditPurchaseActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.PurchaseHistoryActivity" android:exported="false" />
        <activity android:name=".view.ProductDetailsActivity" android:exported="false" />
        <activity android:name=".view.ComparePriceActivity" android:exported="false" />
        <activity android:name=".view.AddExpenseActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.EditExpenseActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.UserManualActivity" android:exported="false" />

        <!-- Administration -->
        <activity android:name=".view.admin.AdminDashboardActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.admin.AdminUsersActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.admin.AdminCategoriesActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.admin.AdminPercentagesActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".view.admin.AdminPointsRulesActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- Service d'arrière-plan -->
        <service android:name=".service.ReminderService" android:exported="false" />

        <!-- FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.masrouf.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
