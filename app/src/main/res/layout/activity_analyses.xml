<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include layout="@layout/view_header"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <LinearLayout android:id="@+id/cardPeriod" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bp_bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_calendar" android:tint="@color/green"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="12dp" android:orientation="vertical">
                    <TextView android:id="@+id/tvPeriod" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvPeriodSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="10sp"/>
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" android:tint="@color/muted"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/emptyCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:background="@drawable/bp_bg_card" android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp" android:visibility="gone">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_info" android:tint="@color/green"/>
                <TextView android:id="@+id/emptyTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/emptyText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/muted" android:textSize="13sp"/>
                <TextView android:id="@+id/emptyBtn" style="@style/BtnPrimary" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="16dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <LinearLayout android:id="@+id/cardSynth" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                    android:background="@drawable/bp_bg_dark" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SYNTHÈSE BUDGÉTAIRE" android:textColor="#CFE3DD" android:textSize="9sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvPill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvBig" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/white" android:textSize="26sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvBigSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#4B6B64" android:textSize="9sp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="#2C4A44"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Budget total" android:textColor="#8FA9A2" android:textSize="9sp"/>
                            <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Budget restant" android:textColor="#8FA9A2" android:textSize="9sp"/>
                            <TextView android:id="@+id/tvRemain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pourcentage consommé" android:textColor="#8FA9A2" android:textSize="9sp"/>
                            <TextView android:id="@+id/tvPct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:background="@drawable/bp_bg_card" android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_sparkle" android:tint="@color/ink"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:text="Conclusion financière" android:textColor="@color/ink" android:textSize="11sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvConclusion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/ink" android:textSize="10sp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/stroke"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_bulb" android:tint="@color/green"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:text="Recommandation personnalisée" android:textColor="@color/green" android:textSize="11sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvReco" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/ink" android:textSize="10sp"/>
                </LinearLayout>

                <TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="Comparaison temporelle"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bp_bg_card" android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CETTE PÉRIODE" android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvCurRange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="9sp"/>
                            <TextView android:id="@+id/tvCurVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/stroke"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PÉRIODE PRÉCÉDENTE" android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvPrevRange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="9sp"/>
                            <TextView android:id="@+id/tvPrevVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bp_bg_info" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
                        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_info" android:tint="@color/green"/>
                        <TextView android:id="@+id/tvCmpInfo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="8dp" android:textColor="@color/ink" android:textSize="9sp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="Consommation du budget"/>
                <LinearLayout android:id="@+id/cardBudget" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bp_bg_card" android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Montant consommé" android:textColor="@color/muted" android:textSize="9sp"/>
                            <TextView android:id="@+id/tvConsumed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Plafond du budget" android:textColor="@color/muted" android:textSize="9sp"/>
                            <TextView android:id="@+id/tvCeil" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/budgetTrack" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp" android:background="@drawable/bg_track" android:weightSum="100">
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:background="@drawable/bg_fill_green"/>
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="98"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                        <TextView android:id="@+id/tvAvail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/muted" android:textSize="9sp"/>
                        <TextView android:id="@+id/tvDaysLeft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="9sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bp_bg_card" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dépenses mensuelles · DT" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Évolution de vos dépenses et achats par rapport à votre budget" android:textColor="@color/muted" android:textSize="9sp"/>
                    <com.example.masrouf.BarChartView android:id="@+id/barChart" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="8dp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvMonths1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginLeft="4dp" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvMonths2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:layout_marginTop="4dp" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold"/>

                <TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" android:text="Consommation par catégorie (Croissante)"/>
                <LinearLayout android:id="@+id/catList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                <TextView android:id="@+id/catEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bp_bg_card" android:padding="14dp" android:text="Aucune dépense enregistrée sur cette période." android:textColor="@color/muted" android:textSize="11sp"/>

                <TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" android:text="Rythme de dépenses quotidien"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bp_bg_card" android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Moyenne par jour" android:textColor="@color/muted" android:textSize="9sp"/>
                            <TextView android:id="@+id/tvAvg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jours écoulés" android:textColor="@color/muted" android:textSize="9sp"/>
                            <TextView android:id="@+id/tvElapsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jours restants" android:textColor="@color/muted" android:textSize="9sp"/>
                            <TextView android:id="@+id/tvLeft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/stroke"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dépense estimée en fin de période :" android:textColor="@color/muted" android:textSize="9sp"/>
                            <TextView android:id="@+id/tvProj" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/statusPill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_green" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
                            <ImageView android:id="@+id/statusIcon" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_check" android:tint="@color/green"/>
                            <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:textColor="@color/green" android:textSize="9sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/tvPaceText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/ink" android:textSize="9sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/attentionBlock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" android:text="Catégorie requérant attention"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_alert" android:orientation="vertical" android:padding="14dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:id="@+id/attIcon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_fork" android:tint="@color/red"/>
                            <TextView android:id="@+id/attName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="8dp" android:textColor="@color/red" android:textSize="12sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/attPct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_red" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="@color/red" android:textSize="9sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <TextView android:id="@+id/attText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/ink" android:textSize="9sp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_alert_inner" android:orientation="vertical" android:padding="10dp">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_shield" android:tint="@color/ink"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:text="Suggestion d'action :" android:textColor="@color/ink" android:textSize="9sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <TextView android:id="@+id/attSuggest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink" android:textSize="9sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>