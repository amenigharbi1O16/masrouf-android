<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayoutChildren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm">

    <!-- CONTENU PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- BARRE SUPÉRIEURE : RETOUR + TITRE + CLOCHE + PROFIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/ivBackChildren"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/deep_forest" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Enfants"
                android:textColor="@color/deep_forest"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Cloche notifications avec badge -->
            <FrameLayout
                android:id="@+id/frameNotifChildren"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/deep_forest" />

                <TextView
                    android:id="@+id/tvChildrenNotifBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge_pill"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Profil Avatar -->
            <ImageView
                android:id="@+id/ivChildrenProfile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/deep_forest" />
        </LinearLayout>

        <!-- CONTENU SCROLLABLE -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="40dp">

                <!-- SOUS-TITRE EN-TÊTE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="FOYER &amp; FAMILLE · GESTION DES ENFANTS"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- LIGNE TITRE : MES ENFANTS (X) + BOUTON AJOUTER CAPSULE DARK -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvChildrenCountTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mes Enfants (0)"
                        android:textColor="@color/deep_forest"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAddNewChildTop"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_capsule_dark"
                        android:paddingHorizontal="16dp"
                        android:text="+ Ajouter un enfant"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PARAGRAPHE EXPLICATIF -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Chaque enfant dispose de son propre compte sécurisé pour suivre son argent de poche et apprendre à gérer son budget en autonomie."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <!-- ÉTAT VIDE (Image 1) -->
                <LinearLayout
                    android:id="@+id/cardEmptyChildren"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_card_white_stroke"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="36dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:src="@drawable/ic_group"
                        app:tint="@color/text_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Aucun enfant pour le moment"
                        android:textColor="@color/deep_forest"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Cliquez sur le bouton ci-dessous pour créer le premier compte enfant de votre foyer."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnAddChildEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_btn_primary"
                        android:paddingHorizontal="24dp"
                        android:text="+ Ajouter un enfant"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- LISTE DES ENFANTS (Image 7) -->
                <LinearLayout
                    android:id="@+id/layoutChildrenList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- INCLUSION DU TIROIR ADMIN / PARENT -->
    <include layout="@layout/layout_admin_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
