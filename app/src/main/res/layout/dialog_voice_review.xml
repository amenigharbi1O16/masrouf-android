<?xml version="1.0" encoding="utf-8"?>
<!--
    RÔLE : Layout de dialogue pour réviser et confirmer l'interprétation vocale (Exigence n°5).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/warm_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Type de transaction"
        android:textColor="@color/deep_forest"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgVoiceType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbVoicePurchase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Achat produit"
            android:textColor="@color/deep_forest"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbVoiceExpense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dépense / Don"
            android:textColor="@color/deep_forest"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- Intitulé / Destinataire -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Intitulé ou Destinataire"
        android:textColor="@color/deep_forest"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etVoiceTitle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_card"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:textColor="@color/deep_forest" />

    <!-- Montant en DT -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Montant en DT"
        android:textColor="@color/deep_forest"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etVoiceAmount"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_card"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:textColor="@color/deep_forest" />

    <!-- Catégorie -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Catégorie"
        android:textColor="@color/deep_forest"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spVoiceCategory"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_card"
        android:paddingHorizontal="8dp" />

    <!-- Date -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Date"
        android:textColor="@color/deep_forest"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etVoiceDate"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_card"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:textColor="@color/deep_forest" />

    <!-- Boutons d'action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVoiceCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary"
            android:text="Annuler"
            android:textColor="@color/deep_forest"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnVoiceConfirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Confirmer"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
