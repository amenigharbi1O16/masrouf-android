<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/bp_bg_card" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/catIcon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_fork" app:tint="@color/amber"/>
        <TextView android:id="@+id/catName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginLeft="8dp" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/catAmount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/catTrack" android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="8dp" android:background="@drawable/bg_track" android:weightSum="100">
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:background="@drawable/bg_fill_amber"/>
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/catShare" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/ink" android:textSize="10sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="(Sans budget alloué)"
            android:textColor="@color/muted" android:textSize="10sp" android:textStyle="italic"/>
    </LinearLayout>
</LinearLayout>