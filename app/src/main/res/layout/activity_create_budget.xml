<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Layout XML de création de budget (Figma 09)
  Conforme à la maquette : 09 · EN / FR / AR · Create budget.png
  EXIGENCES DU PROF COUVERTES :
    - Exigence n°2 (Vues XML, Ch.4).
    - Matrice §4 ligne 5 (Listener explicite via CLASSE NOMMÉE, Ch.4).
    - Matrice §4 ligne 27 (RadioGroup et RadioButtons).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_m"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_l">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBackCreateBudget"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Back"
                android:src="@drawable/ic_menu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_weight="1"
                android:text="Create budget"
                android:textColor="@color/forest"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Profile"
                android:src="@drawable/ic_profile" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.08"
            android:text="A PERIOD THAT WORKS FOR YOU"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_subhead"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Give every dinar a direction."
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Choose any start and end dates, not just a calendar month."
            android:textColor="@color/muted"
            android:textSize="@dimen/text_body" />

        <!-- EXIGENCE MATRICE §4 LIGNE 27 : RadioGroup pour le type de période -->
        <RadioGroup
            android:id="@+id/rgPeriodType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbMonthly"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Calendar month"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbCustom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Custom dates"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- 1. Champ Date de début -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_s">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start date"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_label" />

            <EditText
                android:id="@+id/etStartDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:inputType="date"
                android:minHeight="36dp"
                android:text="2026-11-01"
                android:textColor="@color/ink"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- 2. Champ Date de fin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_s">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End date"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_label" />

            <EditText
                android:id="@+id/etEndDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:inputType="date"
                android:minHeight="36dp"
                android:text="2026-11-30"
                android:textColor="@color/ink"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- 3. Champ Montant total du budget (en DT) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_s">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total budget · DT"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_label" />

            <EditText
                android:id="@+id/etTotalBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:hint="1200.000"
                android:inputType="numberDecimal"
                android:minHeight="36dp"
                android:text="1200.000"
                android:textColor="@color/ink"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- Bannière de validation des dates (Figma 09) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_admin_notice_card"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Check"
                android:src="@drawable/ic_check" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your dates are valid"
                    android:textColor="@color/forest"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="30 days · End date is after start date."
                    android:textColor="@color/forest"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bouton Allouer par catégorie (Primaire) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAllocateCategory"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Allocate by category"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Bouton Annuler (Secondaire) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelBudget"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/forest"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
