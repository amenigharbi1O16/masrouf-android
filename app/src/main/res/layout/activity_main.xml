<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Layout XML de l'écran d'accueil avec TIROIR DE NAVIGATION LATÉRAL (Figma 07 & Figma 08)
  EXIGENCES COUVERTES :
    - DrawerLayout standard Android pour le menu latéral (Side Navigation Drawer).
    - AUCUNE DONNÉE EN DUR : Conteneurs dynamiques pour catégories et transactions, textes localisés via @string/.
    - Conception adaptative pour toutes les tailles d'écrans de smartphones.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:fitsSystemWindows="true">

    <!-- ================================================================= -->
    <!-- 1. CONTENU PRINCIPAL (Tableau de bord utilisateur)                -->
    <!-- ================================================================= -->
    <ScrollView
        android:id="@+id/scrollMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_m"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_l">

            <!-- BARRE SUPÉRIEURE : Bouton 3 lignes (Menu Hamburger) + Salutation dynamique + Profil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivMainMenu"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/drawer_menu_title"
                    android:padding="6dp"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:id="@+id/tvMainGreeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/home_title"
                    android:textColor="@color/forest"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivMainProfile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Profile"
                    android:padding="6dp"
                    android:src="@drawable/ic_profile" />
            </LinearLayout>

            <!-- SOUS-TITRE DE PÉRIODE DYNAMIQUE (ex: "NOVEMBRE 2026 · 01 - 30 NOV") -->
            <TextView
                android:id="@+id/tvMainPeriodSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.06"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- GRANDE CARTE HÉRO SOMBRE DU BUDGET -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_hero_card"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/home_available_to_spend"
                    android:textColor="@color/mint"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Montant restant disponible dynamique -->
                <TextView
                    android:id="@+id/tvMainAvailableAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <!-- Barre de progression horizontale -->
                <ProgressBar
                    android:id="@+id/pbBudgetUsage"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progressTint="@color/mint" />

                <!-- Ligne Dépensé / Pourcentage utilisé -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMainSpentLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/mint"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMainPercentageLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/mint"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Ligne Budget total / Dates -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMainTotalBudgetLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/mint"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMainDateRangeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/mint"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- BANDEAU DYNAMIQUE D'ÉTAT DU BUDGET (Sain < 80%, Alerte 80%, Dépassé 100%) -->
            <LinearLayout
                android:id="@+id/layoutStatusBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/ivStatusIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Status Icon"
                    android:src="@drawable/ic_check" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/forest"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatusDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/forest"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- DEUX BOUTONS D'ACTION RAPIDE (Figma 07) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAddPurchase"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:text="@string/btn_add_purchase"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAddExpense"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:onClick="onQuickExpenseClicked"
                    android:text="@string/btn_add_expense"
                    android:textColor="@color/forest"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SECTION 1 : RÉPARTITION PAR CATÉGORIES (CONTENEUR 100% DYNAMIQUE) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.04"
                android:text="@string/home_section_categories"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Conteneur où le code Java injecte dynamiquement chaque catégorie depuis SQLite -->
            <LinearLayout
                android:id="@+id/layoutCategoriesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- SECTION 2 : DERNIERS ACHATS & DÉPENSES (CONTENEUR 100% DYNAMIQUE) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.04"
                android:text="@string/home_section_recent_purchases"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Conteneur où le code Java injecte dynamiquement les achats réels depuis SQLite -->
            <LinearLayout
                android:id="@+id/layoutTransactionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Message alternatif si aucune transaction n'existe -->
            <TextView
                android:id="@+id/tvEmptyTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_card"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/home_no_transactions"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- ================================================================= -->
    <!-- 2. TIROIR DE NAVIGATION LATÉRAL (Figma 08 - Navigation Drawer)    -->
    <!-- Glisse depuis la gauche (start) avec arrière-plan vert profond    -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/sideDrawer"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/deep_green"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- ScrollView pour s'adapter à toutes les hauteurs d'écrans -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="36dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- EN-TÊTE DU DRAWER : Logo + Titre Masrouf -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="Masrouf Logo"
                        android:src="@drawable/ic_leaf" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:letterSpacing="0.08"
                        android:text="@string/app_name"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PROFIL UTILISATEUR : Nom, Email et Rôle connectés -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_hero_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvDrawerUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Utilisateur"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="email@gmail.com"
                        android:textColor="@color/mint"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDrawerUserRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="@string/drawer_role_user"
                        android:textColor="@color/forest"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- SÉPARATEUR ÉLÉGANT -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp"
                    android:background="#2E6B5C" />

                <!-- LISTE DES ÉLÉMENTS DE NAVIGATION CLICQUABLES (Figma 08) -->

                <!-- 1. Accueil (Home) -->
                <TextView
                    android:id="@+id/btnDrawerHome"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:drawableStart="@drawable/ic_home"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/white"
                    android:text="@string/drawer_nav_home"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 2. Produits & Comparateur (Products) -->
                <TextView
                    android:id="@+id/btnDrawerProducts"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:drawableStart="@drawable/ic_cart"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/white"
                    android:text="@string/drawer_nav_products"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <!-- 3. Calendrier 2026 (Calendar - Vue 100% Java) -->
                <TextView
                    android:id="@+id/btnDrawerCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/white"
                    android:text="@string/drawer_nav_calendar"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <!-- 4. Analyses & Graphiques (Analytics - Vue 100% Java) -->
                <TextView
                    android:id="@+id/btnDrawerAnalytics"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:drawableStart="@drawable/ic_analytics"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/white"
                    android:text="@string/drawer_nav_analytics"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <!-- 5. Gérer le Budget (Create / Modify Budget) -->
                <TextView
                    android:id="@+id/btnDrawerBudget"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:drawableStart="@drawable/ic_wallet"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/white"
                    android:text="@string/drawer_nav_budget"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <!-- 6. Points & Récompenses (Gamification - Figma 21) -->
                <TextView
                    android:id="@+id/btnDrawerPoints"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:drawableStart="@drawable/ic_trophy"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/gold"
                    android:text="@string/drawer_nav_points"
                    android:textColor="@color/gold"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 7. Guide & Manuel utilisateur (PDF) -->
                <TextView
                    android:id="@+id/btnDrawerManual"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:drawableStart="@drawable/ic_book"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/white"
                    android:text="@string/drawer_nav_manual"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <!-- 8. Paramètres & Support (Settings) -->
                <TextView
                    android:id="@+id/btnDrawerSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:drawableStart="@drawable/ic_settings"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/white"
                    android:text="@string/drawer_nav_settings"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <!-- 9. Supervision Administrateur (Visible uniquement si ADMIN) -->
                <TextView
                    android:id="@+id/btnDrawerAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:drawableStart="@drawable/ic_shield"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/gold"
                    android:text="@string/drawer_nav_admin"
                    android:textColor="@color/gold"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- SÉPARATEUR -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="#2E6B5C" />

                <!-- 10. Déconnexion -->
                <TextView
                    android:id="@+id/btnDrawerLogout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:drawableStart="@drawable/ic_logout"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/coral"
                    android:text="@string/drawer_nav_logout"
                    android:textColor="@color/coral"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- PIED DE PAGE : Version de l'application -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/drawer_version"
                    android:textColor="#A0C8BC"
                    android:textSize="11sp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
