<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include layout="@layout/view_header"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DÉTAILS DU PRODUIT" android:textColor="@color/muted" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:background="@drawable/bg_hero" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="10sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvBrand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink" android:textSize="26sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink" android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingRight="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dernier prix unitaire" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvLastPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingRight="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dernier achat" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvLastDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="13sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingRight="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Magasin" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvStore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="13sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:background="@drawable/bg_hero" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/tvCmpTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="12sp"/>
                <TextView android:id="@+id/tvCmpValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:background="@drawable/bp_bg_card" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Évolution du prix" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvChartUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DT / " android:textColor="@color/muted" android:textSize="10sp"/>
                <com.example.masrouf.LineChartView android:id="@+id/chart" android:layout_width="match_parent" android:layout_height="170dp" android:layout_marginTop="8dp"/>
            </LinearLayout>
            <TextView android:id="@+id/btnHistory" style="@style/BtnLight" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="14dp" android:text="Voir l'historique des achats"/>
            <TextView android:id="@+id/btnBuy" style="@style/BtnPrimary" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="+  Ajouter un achat"/>
            <TextView android:id="@+id/btnEdit" style="@style/BtnLight" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="Modifier le produit"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>