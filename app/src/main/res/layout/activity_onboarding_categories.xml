<?xml version="1.0" encoding="utf-8"?>
<!--
    RÔLE : Écran Onboarding 02 / 03 - Sélection des catégories (Figma / Image 04).
    Permet de choisir séparément les catégories de Produits et de Dépenses.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/warm_bg">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/deep_forest" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Vos catégories"
            android:textColor="@color/deep_forest"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivBell"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_bell"
            android:tint="@color/deep_forest" />

        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_profile"
            android:tint="@color/deep_forest" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="02 / 03 · CHOISISSEZ CE QUE VOUS SUIVEZ"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="La vie quotidienne, organisée."
                android:textColor="@color/deep_forest"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Vous pourrez modifier ces catégories à tout moment."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- Badge compteur -->
            <TextView
                android:id="@+id/tvCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="[ ] Catégories sélectionnées : 0"
                android:textColor="@color/deep_forest"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Section 1 : Catégories de produits -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Catégories de produits"
                android:textColor="@color/deep_forest"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Section 2 : Catégories de dépenses -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Catégories de dépenses"
                android:textColor="@color/deep_forest"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Bouton inférieur -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/warm_bg">

        <Button
            android:id="@+id/btnVerifyCategories"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Vérifier les 0 catégories"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:enabled="false"
            android:alpha="0.6" />
    </LinearLayout>

</LinearLayout>
