<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_lang_pill"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:padding="4dp">

    <TextView
        android:id="@+id/tv_lang_en"
        style="@style/LangPillItem"
        android:text="@string/lang_en" />

    <TextView
        android:id="@+id/tv_lang_fr"
        style="@style/LangPillItem"
        android:text="@string/lang_fr" />

    <TextView
        android:id="@+id/tv_lang_ar"
        style="@style/LangPillItem"
        android:text="@string/lang_ar" />
</LinearLayout>
