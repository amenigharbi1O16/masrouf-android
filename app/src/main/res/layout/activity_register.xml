<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Layout XML de l'écran d'inscription (Registration Screen)
  Conforme à la maquette Figma : 02 · EN / FR / AR · Registration.png
  EXIGENCES DU PROF COUVERTES :
    - Exigence n°2 (Vues XML, Ch.4).
    - Matrice §4 ligne 6 (Relié à un listener explicite via classe anonyme).
    - Matrice §4 ligne 17 (Chaînes @string/ multilingues).
    - Matrice §4 ligne 22 & 23 (Couleurs centralisées et unités dp/sp).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_m"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_l">

        <!-- Barre supérieure -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_menu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_weight="1"
                android:text="Create account"
                android:textColor="@color/forest"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_profile" />
        </LinearLayout>

        <!-- Titre et sous-titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.05"
            android:text="A little clarity, every day."
            android:textColor="@color/muted"
            android:textSize="@dimen/text_body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Start your Masrouf journey"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 1. Champ Nom complet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_s">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full name"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_label" />

            <EditText
                android:id="@+id/etRegFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:hint="Ex: Ines Ben Ali"
                android:inputType="textPersonName"
                android:minHeight="36dp"
                android:textColor="@color/ink"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- 2. Champ Adresse e-mail (@gmail.com) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_s">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_label_email"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_label" />

            <EditText
                android:id="@+id/etRegEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:hint="nom@gmail.com"
                android:inputType="textEmailAddress"
                android:minHeight="36dp"
                android:textColor="@color/ink"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- 3. Champ Mot de passe -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_s">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_label_password"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_label" />

            <EditText
                android:id="@+id/etRegPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:inputType="textPassword"
                android:minHeight="36dp"
                android:textColor="@color/ink"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- 4. Champ Confirmation de mot de passe -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_s">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm password"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_label" />

            <EditText
                android:id="@+id/etRegConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:inputType="textPassword"
                android:minHeight="36dp"
                android:textColor="@color/ink"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- Note d'aide sur les contraintes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Use at least 8 characters with an uppercase letter, a number and a symbol."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <!-- Bouton d'inscription (Primaire) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDoRegister"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Create account"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Bouton retour connexion (Secondaire) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="Already registered? Log in"
            android:textAllCaps="false"
            android:textColor="@color/forest"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
