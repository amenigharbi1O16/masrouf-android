<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Layout XML de l'écran de connexion (Login Screen)
  Conforme à 100% à la maquette Figma : 01 · EN / FR / AR · Login.png
  EXIGENCES DU PROF COUVERTES :
    - Exigence n°2 (Vues XML déclaratives, Ch.4).
    - Matrice §4 ligne 7 (Éléments reliés à un listener explicite dans l'activité).
    - Matrice §4 ligne 17 (Toutes les chaînes issues de @string/ pour le multilingue).
    - Matrice §4 ligne 22 & 23 (Couleurs centralisées et unités en dp/sp).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_m"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_l">

        <!-- 1. BARRE SUPÉRIEURE (En-tête avec Menu, Logo Masrouf et Profil) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_menu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_weight="1"
                android:letterSpacing="0.05"
                android:text="@string/app_name"
                android:textColor="@color/forest"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/login_label_email"
                android:src="@drawable/ic_profile" />
        </LinearLayout>

        <!-- 2. SOUS-TITRE / SLOGAN EN MAJUSCULES (ex: "YOUR MONEY. YOUR BALANCE.") -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.08"
            android:text="@string/login_tagline"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_subhead"
            android:textStyle="bold" />

        <!-- 3. CARTE HÉRO SOMBRE (Forest #102B27 avec logo feuille et devise "Spend with intention.") -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hero_card"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/login_hero_title"
                android:src="@drawable/ic_leaf" />

            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/login_hero_title"
                android:textColor="@color/white"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. TITRE DE SECTION (ex: "Welcome back" / "Heureux de vous revoir") -->
        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/login_welcome_title"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/login_welcome_subtitle"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_body" />

        <!-- 5. CHAMP DE SAISIE EMAIL (Carte blanche arrondie avec label interne) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_s">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_label_email"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_label" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:hint="@string/login_hint_email"
                android:inputType="textEmailAddress"
                android:minHeight="36dp"
                android:text="ines.benali@gmail.com"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted_light"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- 6. CHAMP DE SAISIE MOT DE PASSE (Carte blanche arrondie) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_s">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_label_password"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_label" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@null"
                android:inputType="textPassword"
                android:minHeight="36dp"
                android:text="User123!"
                android:textColor="@color/ink"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- 7. BOUTON PRINCIPAL "LOG IN" (Vert forêt foncé) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/login_btn_login"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 8. BOUTON SECONDAIRE "CREATE AN ACCOUNT" (Vert menthe clair) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCreateAccount"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="@string/login_btn_create_account"
            android:textAllCaps="false"
            android:textColor="@color/forest"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 9. SÉLECTEUR DE LANGUE AU PIED DE PAGE (EN / FR / العربية) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLangEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/lang_en"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" / "
                android:textColor="@color/muted_light"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLangFr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/lang_fr"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" / "
                android:textColor="@color/muted_light"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLangAr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/lang_ar"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
