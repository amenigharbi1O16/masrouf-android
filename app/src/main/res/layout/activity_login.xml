<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Layout XML de l'écran de connexion (Login Screen)
  Conforme à 100% au design system Masrouf et aux spécifications
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- 1. TITRE DE L'APPLICATION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:text="MASROUF"
            android:textColor="@color/deep_forest"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 2. SÉLECTEUR DE LANGUE (3 PILULES : Français / العربية / English) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnLangFr"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_active"
                android:gravity="center"
                android:text="Français"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLangAr"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_pill_inactive"
                android:gravity="center"
                android:text="العربية"
                android:textColor="@color/deep_forest"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLangEn"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_inactive"
                android:gravity="center"
                android:text="English"
                android:textColor="@color/deep_forest"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. ÉTIQUETTE DE SOUS-TITRE EN MAJUSCULES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.06"
            android:text="GESTION DES FINANCES PERSONNELLES"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 4. CARTE HÉRO SOMBRE 176DP (Feuille + "Bienvenue sur Masrouf") -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hero_card"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Masrouf Logo"
                android:src="@drawable/ic_leaf"
                android:tint="@color/mint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.06"
                android:text="MON ESPACE PERSONNEL"
                android:textColor="@color/mint"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bienvenue sur Masrouf"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5. TITRE ET SOUS-TITRE DE CONNEXION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Se connecter"
            android:textColor="@color/deep_forest"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Connectez-vous pour accéder à vos comptes et budgets."
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- BANNER ERREUR CORAIL CONDITIONNEL -->
        <TextView
            android:id="@+id/tvLoginErrorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_card"
            android:padding="12dp"
            android:text="⚠️ Identifiants incorrects. Veuillez réessayer."
            android:textColor="@color/coral"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 6. CHAMP DE SAISIE ADRESSE E-MAIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adresse e-mail"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@null"
                android:hint="name@gmail.com"
                android:inputType="textEmailAddress"
                android:minHeight="36dp"
                android:textColor="@color/deep_forest"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- 7. CHAMP DE SAISIE MOT DE PASSE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mot de passe"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@null"
                android:hint="Saisir votre mot de passe"
                android:inputType="textPassword"
                android:minHeight="36dp"
                android:textColor="@color/deep_forest"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp"
                tools:ignore="Autofill" />
        </LinearLayout>

        <!-- 8. BOUTON PRINCIPAL "SE CONNECTER" (52DP) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Se connecter"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 9. BOUTON SECONDAIRE "CRÉER UN COMPTE" -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCreateAccount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="Créer un compte"
            android:textAllCaps="false"
            android:textColor="@color/deep_forest"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>