<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:text="@string/app_name"
            android:textColor="@color/dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <include
            layout="@layout/view_lang_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.06"
            android:text="@string/section_label"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hero_card"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_leaf"
                android:tint="@color/mint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.06"
                android:text="@string/login_tagline"
                android:textColor="@color/mint"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/login_welcome"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/login_title"
            android:textColor="@color/dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/login_subtitle"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_login_error_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_card"
            android:padding="12dp"
            android:text="@string/error_invalid_credentials"
            android:textColor="@color/coral"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout style="@style/FieldBox">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/field_email" />

            <EditText
                android:id="@+id/et_email"
                style="@style/FieldInput"
                android:autofillHints="emailAddress"
                android:hint="@string/login_hint_email"
                android:importantForAutofill="yes"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <LinearLayout style="@style/FieldBox">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/field_password" />

            <EditText
                android:id="@+id/et_password"
                style="@style/FieldInput"
                android:autofillHints="password"
                android:importantForAutofill="yes"
                android:inputType="textPassword" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_login"
            style="@style/BtnPrimary"
            android:layout_marginTop="20dp"
            android:text="@string/login_btn_login" />

        <TextView
            android:id="@+id/btn_create_account"
            style="@style/BtnSecondary"
            android:layout_marginTop="12dp"
            android:onClick="onCreateAccountClick"
            android:text="@string/login_btn_create_account" />

    </LinearLayout>
</ScrollView>