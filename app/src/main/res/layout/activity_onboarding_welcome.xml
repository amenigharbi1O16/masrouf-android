<?xml version="1.0" encoding="utf-8"?>
<!--
    RÔLE : Écran d'accueil Onboarding & Présentation (Welcome Flow).
    Reproduction exacte des 5 vues de la version React Native (/welcome).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:orientation="vertical">

    <!-- BARRE SUPÉRIEURE COMMUNE (Bouton Retour < + Langue EN/FR/AR + Passer) -->
    <LinearLayout
        android:id="@+id/layoutWelcomeHeader"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/ivWelcomeBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_mint"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/deep_forest"
            android:visibility="invisible" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Sélecteur de langue pilules EN / FR / عربي -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_input_card"
            android:gravity="center_vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/btnWelcomeLangEn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pill_inactive"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/lang_en"
                android:textColor="@color/deep_forest"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnWelcomeLangFr"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pill_active"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/lang_fr"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnWelcomeLangAr"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pill_inactive"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/lang_ar"
                android:textColor="@color/deep_forest"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWelcomeSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/welcome_skip"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- ZONE DE CONTENU VARIABLE EN 3 PHASES -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============================================================= -->
        <!-- PHASE 1 : SPLASH / ACCUEIL INITIAL                            -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/layoutPhase1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="Masrouf Logo"
                android:src="@drawable/ic_leaf"
                android:tint="@color/deep_forest" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/welcome_welcome_to"
                android:textColor="@color/primary_emerald"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/welcome_app_title"
                android:textColor="@color/deep_forest"
                android:textSize="40sp"
                android:textStyle="bold" />

            <!-- Ligne de soulignement vert menthe -->
            <View
                android:layout_width="120dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_active" />
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- PHASE 2 : CARROUSEL DES 3 SLIDES DÉMONSTRATIVES               -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/layoutPhase2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="vertical">

                    <!-- Carte centrale de diapositive -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:id="@+id/ivSlideIcon"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_circle_mint"
                            android:padding="16dp"
                            android:src="@drawable/ic_wallet"
                            android:tint="@color/deep_forest" />

                        <TextView
                            android:id="@+id/tvSlideTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:text="@string/welcome_slide1_title"
                            android:textColor="@color/deep_forest"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSlideDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/welcome_slide1_desc"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="@color/border_subtle" />

                        <!-- Check Item 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_check_circle"
                                android:tint="@color/deep_forest" />

                            <TextView
                                android:id="@+id/tvSlideCheck1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/welcome_slide1_check1"
                                android:textColor="@color/deep_forest"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Check Item 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_check_circle"
                                android:tint="@color/deep_forest" />

                            <TextView
                                android:id="@+id/tvSlideCheck2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/welcome_slide1_check2"
                                android:textColor="@color/deep_forest"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Indicateurs de pagination (Dots) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/dot1"
                            android:layout_width="24dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_pill_active" />

                        <View
                            android:id="@+id/dot2"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_pill_inactive" />

                        <View
                            android:id="@+id/dot3"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_inactive" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- PHASE 3 : CHOIX DU TYPE DE COMPTE                             -->
        <!-- ============================================================= -->
        <ScrollView
            android:id="@+id/layoutPhase3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/welcome_choice_subtitle"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/welcome_choice_title"
                    android:textColor="@color/deep_forest"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/welcome_choice_desc"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <!-- CARTE 1 : COMPTE PERSONNEL -->
                <LinearLayout
                    android:id="@+id/cardPersonalChoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_input_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_mint"
                            android:padding="10dp"
                            android:src="@drawable/ic_profile"
                            android:tint="@color/deep_forest" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/welcome_card_personal_title"
                                android:textColor="@color/deep_forest"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/welcome_card_personal_desc"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_inactive"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/welcome_card_personal_badge"
                            android:textColor="@color/deep_forest"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/border_subtle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_card_personal_check1"
                        android:textColor="@color/deep_forest"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/welcome_card_personal_check2"
                        android:textColor="@color/deep_forest"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/welcome_card_personal_check3"
                        android:textColor="@color/deep_forest"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/welcome_card_personal_action"
                        android:textColor="@color/deep_forest"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- CARTE 2 : COMPTE FAMILLE (PARENT) -->
                <LinearLayout
                    android:id="@+id/cardFamilyChoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_mint"
                            android:padding="10dp"
                            android:src="@drawable/ic_profile"
                            android:tint="@color/deep_forest" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/welcome_card_family_title"
                                android:textColor="@color/deep_forest"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/welcome_card_family_desc"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_active"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/welcome_card_family_badge"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/border_subtle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_card_family_check1"
                        android:textColor="@color/deep_forest"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/welcome_card_family_check2"
                        android:textColor="@color/deep_forest"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/welcome_card_family_check3"
                        android:textColor="@color/deep_forest"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/welcome_card_family_check4"
                        android:textColor="@color/deep_forest"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/welcome_card_family_action"
                        android:textColor="@color/deep_forest"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- PIED DE PAGE : BOUTON PRINCIPAL + LIEN DE CONNEXION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWelcomeMainAction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/welcome_btn_start"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnWelcomeGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/welcome_already_have_account"
            android:textColor="@color/deep_forest"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
