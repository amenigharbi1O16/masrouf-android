<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Layout XML du catalogue de produits et comparaison des prix (Figma 12)
  Conforme à la maquette : 12 · EN / FR / AR · Products.png
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_m"
    android:paddingTop="20dp"
    android:paddingEnd="@dimen/spacing_m"
    android:paddingBottom="@dimen/spacing_m">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivBackProducts"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_menu" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:text="Tracked products"
            android:textColor="@color/forest"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivAddProductFromToolbar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Add Product"
            android:padding="4dp"
            android:src="@drawable/ic_add"
            android:tint="@color/forest" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:letterSpacing="0.08"
        android:text="PRICE INTEGRITY"
        android:textColor="@color/muted"
        android:textSize="@dimen/text_subhead"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Compare unit prices across purchases."
        android:textColor="@color/muted"
        android:textSize="@dimen/text_body" />

    <!-- ListView gérée par l'Adapter personnalisé BaseAdapter (Ch.6 du cours) -->
    <ListView
        android:id="@+id/lvProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <!-- Actions bas de page -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNewPurchaseFromProducts"
            android:layout_width="0dp"
            android:layout_height="@dimen/control_height"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:text="+ Purchase"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewPurchaseHistory"
            android:layout_width="0dp"
            android:layout_height="@dimen/control_height"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary"
            android:text="@string/purchase_history_title"
            android:textAllCaps="false"
            android:textColor="@color/forest"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
