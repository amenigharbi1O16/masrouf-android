<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include layout="@layout/view_header"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:id="@+id/periodBanner" android:layout_width="match_parent" android:layout_height="40dp"
                android:background="@drawable/bp_bg_info" android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingLeft="14dp" android:paddingRight="14dp">
                <TextView android:id="@+id/periodText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:id="@+id/periodChange" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/green" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="VOS ESSENTIELS DU QUOTIDIEN" android:textColor="@color/muted" android:textSize="14sp"/>
            <LinearLayout style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <TextView style="@style/FieldLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rechercher des produits"/>
                <EditText android:id="@+id/search" style="@style/FieldInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Rechercher par nom ou marque" android:textSize="17sp" android:textStyle="normal"/>
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/chips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
            </HorizontalScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp" android:orientation="horizontal">
                <TextView android:id="@+id/count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:id="@+id/sort" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nom A–Z" android:textColor="@color/green" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bp_bg_card" android:gravity="center" android:padding="24dp" android:visibility="gone"
                android:text="Aucun produit pour le moment.\nAjoutez votre premier produit pour suivre ses prix."
                android:textColor="@color/muted" android:textSize="13sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Catégories de produits uniquement. Les dépenses restent séparées." android:textColor="@color/muted" android:textSize="13sp"/>
            <TextView android:id="@+id/btnAdd" style="@style/BtnPrimary" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="16dp" android:text="+  Ajouter un produit" android:textSize="16sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>