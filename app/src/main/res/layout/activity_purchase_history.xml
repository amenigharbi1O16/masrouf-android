<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_m"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/spacing_m"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/ivBackPurchaseHistory"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/forest" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/purchase_history_title"
            android:textColor="@color/forest"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/spacing_m"
        android:layout_marginEnd="@dimen/spacing_m"
        android:background="@drawable/bg_input_card"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <EditText
            android:id="@+id/etSearchPurchases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="Search purchases..."
            android:inputType="text"
            android:textColor="@color/ink"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Total Purchases Counter -->
    <TextView
        android:id="@+id/tvTotalPurchasesCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:layout_marginTop="12dp"
        android:letterSpacing="0.06"
        android:text="ALL TRANSACTIONS"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Purchases List -->
    <ListView
        android:id="@+id/lvPurchaseHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:paddingStart="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_m" />

</LinearLayout>
