<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Barre du haut : retour + titre + cloche + profil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:clickable="true"
                android:contentDescription="@string/app_name"
                android:focusable="true"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/signup_title"
                android:textColor="@color/dark"
                android:textSize="21sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bell" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_account_circle" />
        </LinearLayout>

        <include
            layout="@layout/view_lang_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/section_label"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/signup_title"
            android:textColor="@color/dark"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Choix du type : Personnel / Famille -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tab_personal"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_personal_on"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_tab_personal"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_person" />

                <TextView
                    android:id="@+id/tv_tab_personal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/tab_personal"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_family"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_off"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_tab_family"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_group" />

                <TextView
                    android:id="@+id/tv_tab_family"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/tab_family"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bandeau d'information (change selon le type) -->
        <LinearLayout
            android:id="@+id/banner_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_info_personal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/iv_banner"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_account_circle" />

            <TextView
                android:id="@+id/tv_banner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/info_personal"
                android:textColor="@color/dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/local_note"
            android:textColor="@color/muted"
            android:textSize="14.5sp" />

        <!-- Nom complet -->
        <LinearLayout style="@style/FieldBox">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/field_name" />

            <EditText
                android:id="@+id/et_name"
                style="@style/FieldInput"
                android:autofillHints="name"
                android:hint="@string/hint_name"
                android:importantForAutofill="yes"
                android:inputType="textPersonName|textCapWords" />
        </LinearLayout>

        <!-- E-mail -->
        <LinearLayout style="@style/FieldBox">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/field_email" />

            <EditText
                android:id="@+id/et_email"
                style="@style/FieldInput"
                android:autofillHints="emailAddress"
                android:importantForAutofill="yes"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- Mot de passe -->
        <LinearLayout style="@style/FieldBox">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/field_password" />

            <EditText
                android:id="@+id/et_password"
                style="@style/FieldInput"
                android:autofillHints="newPassword"
                android:importantForAutofill="yes"
                android:inputType="textPassword" />
        </LinearLayout>

        <!-- Confirmation -->
        <LinearLayout style="@style/FieldBox">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/field_confirm" />

            <EditText
                android:id="@+id/et_confirm"
                style="@style/FieldInput"
                android:autofillHints="newPassword"
                android:hint="@string/hint_confirm"
                android:importantForAutofill="yes"
                android:inputType="textPassword" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_signup"
            style="@style/BtnPrimary"
            android:layout_marginTop="14dp"
            android:text="@string/btn_signup" />

        <TextView
            android:id="@+id/btn_go_login"
            style="@style/BtnSecondary"
            android:layout_marginTop="12dp"
            android:text="@string/login" />
    </LinearLayout>
</ScrollView>
