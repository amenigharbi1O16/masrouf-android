<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- EN-TÊTE : TITRE + BOUTON FERMER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ajouter un enfant"
            android:textColor="@color/deep_forest"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCloseAddChild"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- CHAMP 1 : NOM COMPLET -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Nom complet de l'enfant"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etAddChildName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_card"
        android:hint="Ex: Youssef Ben Ali"
        android:inputType="textPersonName"
        android:paddingHorizontal="16dp"
        android:textColor="@color/deep_forest"
        android:textSize="14sp" />

    <!-- CHAMP 2 : EMAIL DE CONNEXION (GMAIL) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Adresse email de connexion (Gmail)"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etAddChildEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_card"
        android:hint="Ex: enfant@gmail.com"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp"
        android:textColor="@color/deep_forest"
        android:textSize="14sp" />

    <!-- CHAMP 3 : MOT DE PASSE INITIAL -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mot de passe initial (8+ caractères)"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etAddChildPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_card"
        android:hint="••••••••••"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:textColor="@color/deep_forest"
        android:textSize="14sp" />

    <!-- BOUTONS D'ACTION -->
    <Button
        android:id="@+id/btnSubmitAddChild"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_btn_primary"
        android:text="Créer le compte enfant"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCancelAddChild"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_capsule_mint"
        android:text="Annuler"
        android:textAllCaps="false"
        android:textColor="@color/deep_forest"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
