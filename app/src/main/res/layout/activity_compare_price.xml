<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Layout XML de comparaison de prix avant confirmation (Figma 18)
  Conforme à la maquette : 18 · EN / FR / AR · Compare price.png
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_m"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_l">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBackComparePrice"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Back"
                android:src="@drawable/ic_menu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_weight="1"
                android:text="Compare price"
                android:textColor="@color/forest"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Profile"
                android:src="@drawable/ic_profile" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.08"
            android:text="BEFORE YOU CONFIRM"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_subhead"
            android:textStyle="bold" />

        <!-- 1. Carte Produit sélectionné -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_admin_notice_card"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Prod"
                    android:src="@drawable/ic_leaf" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCompareProdName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olive oil"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCompareProdSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Châal · Food · 1 L"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Comparatif des prix unitaires -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Previous unit price"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvPreviousUnitPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15.000 DT / L"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="New unit price"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvNewUnitPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14.500 DT / L"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Bannière verte d'évolution de prix (Figma 18) -->
        <LinearLayout
            android:id="@+id/layoutPriceChangeBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_admin_notice_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvPriceChangeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓ Price decrease"
                android:textColor="@color/forest"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPriceDifferenceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="–0.500 DT / –3.3%"
                android:textColor="@color/forest"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. Magasin précédent -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Previous purchase"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 Oct 2026"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Previous store"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carrefour"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5. Total de l'achat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Purchase total"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvComparePurchaseTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14.500 DT"
                android:textColor="@color/forest"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bouton Confirmer l'achat -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmPurchase"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Confirm purchase"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Bouton Modifier l'achat -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEditPurchase"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="Edit purchase"
            android:textAllCaps="false"
            android:textColor="@color/forest"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
