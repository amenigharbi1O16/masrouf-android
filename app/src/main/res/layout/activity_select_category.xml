<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Layout XML de sélection de catégorie
  EXIGENCES DU PROF COUVERTES :
    - Matrice §4 ligne 28 : ListView avec ArrayAdapter (Ch.6).
    - Matrice §4 ligne 10 : Écran de sélection appelé par startActivityForResult avec renvoi via setResult.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_m"
    android:paddingTop="20dp"
    android:paddingEnd="@dimen/spacing_m"
    android:paddingBottom="@dimen/spacing_m">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivBackCategory"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_menu" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:text="Choose a category"
            android:textColor="@color/forest"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Select the category for your purchase or expense:"
        android:textColor="@color/muted"
        android:textSize="@dimen/text_body" />

    <!-- ListView gérée par ArrayAdapter (Ch.6 du cours) -->
    <ListView
        android:id="@+id/lvCategories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:divider="@color/border_subtle"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnCancelCategory"
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_height"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_secondary"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="@color/forest"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
