<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout XML : Écran Paramètres, Assistance et Démonstrations Techniques (Figma 22 / Lab 3 / Ch. 5)
  EXIGENCES DU PROF COUVERTES :
    - Matrice §4 ligne 11 : Intent implicite ACTION_DIAL et ACTION_CALL (avec demande de permission runtime).
    - Matrice §4 ligne 12 : Intent implicite SMS ACTION_SENDTO (smsto:).
    - Matrice §4 ligne 13 : Intent implicite ACTION_SEND avec Chooser.
    - Matrice §4 ligne 14 : Intent implicite ACTION_VIEW (Guide utilisateur & web).
    - Matrice §4 ligne 17 : Changement de langue dynamique (EN / FR / AR).
    - Matrice §4 ligne 20 : Lecture audio depuis res/raw/budget_alert.wav.
    - Matrice §4 ligne 35 : Déclenchement de Notification avec NotificationChannel et PendingIntent.
    - Matrice §4 ligne 36 : Démarrage du Service en arrière-plan (ReminderService).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Barre de titre avec retour -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/btn_back_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:text="←"
                android:textColor="@color/deep_forest"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Paramètres &amp; Support"
                android:textColor="@color/deep_forest"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARTE 1 : Langue de l'application (Multilingue EN / FR / AR) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 Langue de l'application (i18n)"
                android:textColor="@color/deep_forest"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:text="Basculez entre Anglais, Français et Arabe (support RTL)"
                android:textColor="#666666"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rg_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_lang_fr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Français"
                    android:textColor="@color/deep_forest" />

                <RadioButton
                    android:id="@+id/rb_lang_en"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="English"
                    android:textColor="@color/deep_forest" />

                <RadioButton
                    android:id="@+id/rb_lang_ar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="العربية"
                    android:textColor="@color/deep_forest" />
            </RadioGroup>
        </LinearLayout>

        <!-- CARTE 2 : DÉMONSTRATION DES INTENTS IMPLICITES (Ch. 5 du cours) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞 Intents Implicites Téléphonie &amp; SMS"
                android:textColor="@color/deep_forest"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- ACTION_DIAL (Sans permission) -->
            <Button
                android:id="@+id/btn_action_dial"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Composeur (ACTION_DIAL : 71 000 000)"
                android:textColor="@color/deep_forest"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- ACTION_CALL (Permission dangereuse CALL_PHONE à l'exécution) -->
            <Button
                android:id="@+id/btn_action_call"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Appel Direct (ACTION_CALL + Runtime Permission)"
                android:textColor="@color/deep_forest"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- ACTION_SENDTO SMS -->
            <Button
                android:id="@+id/btn_action_sms"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="SMS Support (ACTION_SENDTO : smsto:)"
                android:textColor="@color/deep_forest"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARTE 3 : INTENTS IMPLICITES DOCUMENT & PARTAGE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📄 Documents (assets) &amp; Partage Chooser"
                android:textColor="@color/deep_forest"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Lire le fichier asset masrouf_manual.txt -->
            <Button
                android:id="@+id/btn_read_manual_asset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Consulter le Guide (Lecture dossier assets)"
                android:textColor="@color/deep_forest"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- ACTION_VIEW Web URL -->
            <Button
                android:id="@+id/btn_action_view_web"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Portail Web Masrouf (ACTION_VIEW : https://)"
                android:textColor="@color/deep_forest"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- ACTION_SEND + Intent.createChooser -->
            <Button
                android:id="@+id/btn_action_share"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Recommander Masrouf (ACTION_SEND + Chooser)"
                android:textColor="@color/deep_forest"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARTE 4 : AUDIO RAW, NOTIFICATIONS & SERVICE D'ARRIÈRE-PLAN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 Notifications, Audio res/raw &amp; Service"
                android:textColor="@color/deep_forest"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Audio res/raw -->
            <Button
                android:id="@+id/btn_play_audio_raw"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="🔊 Jouer Alerte Audio (res/raw/budget_alert.wav)"
                android:textColor="@color/deep_forest"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Notification test -->
            <Button
                android:id="@+id/btn_trigger_notification"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="🔔 Déclencher Notification (PendingIntent)"
                android:textColor="@color/deep_forest"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Service test -->
            <Button
                android:id="@+id/btn_start_service"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="⚙ Lancer ReminderService (Started Service)"
                android:textColor="@color/deep_forest"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bouton Déconnexion -->
        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Se Déconnecter"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
