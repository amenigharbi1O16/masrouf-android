<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- POIGNÉE DU BOTTOM SHEET -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_inactive" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Source de la photo"
        android:textColor="@color/deep_forest"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Choisissez une méthode pour ajouter une photo"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- OPTION 1 : APPAREIL PHOTO -->
        <LinearLayout
            android:id="@+id/btnOptionCamera"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Camera"
                android:src="@drawable/ic_camera"
                app:tint="@color/deep_forest" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Prendre une photo (Appareil photo)"
                android:textColor="@color/deep_forest"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- OPTION 2 : GALERIE LOCAL -->
        <LinearLayout
            android:id="@+id/btnOptionGallery"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Gallery"
                android:src="@drawable/ic_image"
                app:tint="@color/deep_forest" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Choisir depuis la galerie"
                android:textColor="@color/deep_forest"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- OPTION 3 : SUPPRIMER LA PHOTO -->
        <LinearLayout
            android:id="@+id/btnOptionDeletePhoto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Delete"
                android:src="@drawable/ic_logout"
                app:tint="@color/coral" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Supprimer la photo actuelle"
                android:textColor="@color/coral"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- OPTION 4 : ANNULER -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOptionCancel"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_inactive"
            android:text="Annuler"
            android:textAllCaps="false"
            android:textColor="@color/deep_forest"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>