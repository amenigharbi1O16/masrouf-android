<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- POIGNÉE DU BOTTOM SHEET -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_inactive" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ajouter une catégorie"
        android:textColor="@color/deep_forest"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Personnalisez vos catégories et leur allocation budgétaire"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- ONGLETS : TYPE PRODUIT vs DÉPENSE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_card"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabCategoryProduct"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_active"
            android:gravity="center"
            android:text="🛒 Catégorie Produit"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabCategoryExpense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_inactive"
            android:gravity="center"
            android:text="🧾 Catégorie Dépense"
            android:textColor="@color/deep_forest"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SUGGESTIONS NOUVELLES CATÉGORIES OFFICIELLES -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Suggestions rapides :"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerCategorySuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- CHAMP NOM DE CATÉGORIE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Nom de la catégorie"
        android:textColor="@color/deep_forest"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCustomCatName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_card"
        android:hint="Ex: Sport, Café, Bricolage..."
        android:paddingHorizontal="14dp"
        android:textColor="@color/deep_forest"
        android:textSize="14sp" />

    <!-- SELECTION D'ICONE (GRILLE DE 16 ICONES) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Icône de la catégorie"
        android:textColor="@color/deep_forest"
        android:textSize="13sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerIconPalette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- ALLOCATION POURCENTAGE OBLIGATOIRE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Allocation (% du budget)"
            android:textColor="@color/deep_forest"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRemainingPercentSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reste 20% disponible"
            android:textColor="@color/primary_emerald"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCustomCatPercent"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_card"
            android:hint="Ex: 10"
            android:inputType="numberDecimal"
            android:paddingHorizontal="14dp"
            android:textColor="@color/deep_forest"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCalculatedDtAllocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="= 0.000 DT"
            android:textColor="@color/deep_forest"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- MESSAGE D'ERREUR SI DÉPASSEMENT 100% -->
    <TextView
        android:id="@+id/tvCatAllocationError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_card"
        android:padding="10dp"
        android:text="⚠️ Le total des allocations dépasse 100%. Réduisez le pourcentage."
        android:textColor="@color/coral"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- BOUTON ENREGISTRER (52DP FOREST GREEN) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveCustomCategory"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_btn_primary"
        android:text="Enregistrer la catégorie"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>