<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Dimensions et échelle typographique de l'application Masrouf
  Conforme aux spécifications du design system Figma (MASROUF · Product and implementation guide.png)
  EXIGENCE DU PROF : Utilisation stricte des unités dp (dimensions) et sp (textes) (Ch.3 & Ch.4)
-->
<resources>
    <!-- Espacements géométriques (Spacing en dp) -->
    <dimen name="spacing_xxs">4dp</dimen>         <!-- Espacement micro (entre icône et texte de badge) -->
    <dimen name="spacing_xs">8dp</dimen>          <!-- Espacement très compact -->
    <dimen name="spacing_s">12dp</dimen>          <!-- Espacement moyen-fin (padding interne d'input) -->
    <dimen name="spacing_m">16dp</dimen>          <!-- Marge extérieure standard de l'écran et padding de carte -->
    <dimen name="spacing_l">24dp</dimen>          <!-- Espacement entre grands blocs de contenu -->
    <dimen name="spacing_xl">32dp</dimen>         <!-- Marge aérée avant les boutons d'action -->

    <!-- Hauteurs des composants de contrôle -->
    <dimen name="control_height">54dp</dimen>     <!-- Hauteur standard des boutons principaux et secondaires (52-56dp) -->
    <dimen name="input_min_height">56dp</dimen>   <!-- Hauteur minimale des blocs de saisie de texte -->

    <!-- Rayons de courbure des coins (Corner Radius en dp) -->
    <dimen name="radius_card_s">16dp</dimen>      <!-- Rayon pour cartes blanches de formulaires -->
    <dimen name="radius_card_l">24dp</dimen>      <!-- Rayon pour la carte héro sombre -->
    <dimen name="radius_btn">20dp</dimen>         <!-- Rayon arrondi des boutons d'action (style pilule arrondie) -->

    <!-- Échelle typographique (Typography Scale en sp) -->
    <dimen name="text_display">34sp</dimen>       <!-- Grands nombres (ex: compteur 248, montants budgétaires) -->
    <dimen name="text_title">26sp</dimen>         <!-- Titres héro de cartes ("Spend with intention.") -->
    <dimen name="text_section">18sp</dimen>       <!-- Titres de section ("Welcome back", "Vue d'ensemble") -->
    <dimen name="text_body">14sp</dimen>          <!-- Texte courant, saisies de formulaires, paragraphes -->
    <dimen name="text_label">12sp</dimen>         <!-- Étiquettes de champs ("Email address", "COMPTES ACTIFS") -->
    <dimen name="text_subhead">11sp</dimen>       <!-- Petits sur-titres en majuscules ("YOUR MONEY. YOUR BALANCE.") -->
</resources>
