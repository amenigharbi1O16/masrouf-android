<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fond blanc avec coins arrondis 20dp -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#E2E7DF" />
        </shape>
    </item>
    <!-- Bordure supérieure menthe de 4px (2dp) -->
    <item android:bottom="20dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#A8D5A0" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
        </shape>
    </item>
</layer-list>
